#!/bin/bash

# kats - Ultra-Fast Language Analyzer Tool v1.2
# Analyzes a project directory and shows percentage of different programming languages
# Enhanced with gitignore support, color output, and parallel processing

# Check if we're using bash (not sh)
if [[ -z "$BASH_VERSION" ]]; then
    echo "Error: kats must be run with bash, not sh"
    exit 1
fi

# ANSI Colors
BOLD="\033[1m"
RED="\033[31m"
GREEN="\033[32m"
YELLOW="\033[33m"
BLUE="\033[34m"
CYAN="\033[36m"
RESET="\033[0m"

# Disable colors if not outputting to a terminal
if [[ ! -t 1 ]]; then
    BOLD=""
    RED=""
    GREEN=""
    YELLOW=""
    BLUE=""
    CYAN=""
    RESET=""
fi

# Function to show help
show_help() {
    echo "Usage: kats [directory]"
    echo ""
    echo "Analyzes a project directory and shows percentage of different programming languages."
    echo ""
    echo "Options:"
    echo "  -h, --help    Show this help message"
    echo "  -v, --version Show version information"
    echo "  --top N       Show top N languages (default: 10)"
    echo ""
    echo "If no directory is specified, the current directory is analyzed."
    echo "If the directory is a git repository, .gitignore patterns are respected."
}

# Function to show version
show_version() {
    echo "kats v1.2"
    echo "Enhanced language analyzer with gitignore support and color output"
}

# Default settings
TOP_LANGUAGES=10

# Parse command line arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -h|--help)
            show_help
            exit 0
            ;; 
        -v|--version)
            show_version
            exit 0
            ;; 
        --top)
            if [[ -n "$2" && "$2" =~ ^[0-9]+$ ]]; then
                TOP_LANGUAGES="$2"
                shift
            else
                echo -e "${RED}Error: --top requires a number${RESET}"
                show_help
                exit 1
            fi
            ;; 
        -*)
            echo -e "${RED}Unknown option: $1${RESET}"
            show_help
            exit 1
            ;; 
        *)
            if [[ -z "$TARGET_DIR" ]]; then
                TARGET_DIR="$1"
            else
                echo -e "${RED}Error: Only one directory can be specified${RESET}"
                show_help
                exit 1
            fi
            ;; 
    esac
    shift
done

# Set target directory (default to current directory)
if [[ -z "$TARGET_DIR" ]]; then
    TARGET_DIR="."
fi

# Check if directory exists
if [[ ! -d "$TARGET_DIR" ]]; then
    echo -e "${RED}Error: Directory '$TARGET_DIR' does not exist${RESET}"
    exit 1
fi

# Language extensions mapping (optimized for speed)
# Format: extension:language
LANGUAGE_MAPPING=(
    "rs:Rust"
    "c:C"
    "h:C"
    "cpp:C++"
    "cxx:C++"
    "cc:C++"
    "hpp:C++"
    "hxx:C++"
    "hh:C++"
    "py:Python"
    "js:JavaScript"
    "mjs:JavaScript"
    "cjs:JavaScript"
    "ts:TypeScript"
    "tsx:TypeScript"
    "java:Java"
    "go:Go"
    "rb:Ruby"
    "php:PHP"
    "swift:Swift"
    "kt:Kotlin"
    "kts:Kotlin"
    "sh:Shell"
    "bash:Shell"
    "zsh:Shell"
    "fish:Shell"
    "html:HTML"
    "htm:HTML"
    "css:CSS"
    "sql:SQL"
    "json:JSON"
    "yaml:YAML"
    "yml:YAML"
    "xml:XML"
    "md:Markdown"
    "markdown:Markdown"
    "txt:Text"
    "text:Text"
    "cs:C#"
    "cshtml:C#"
    "razor:C#"
    "scala:Scala"
    "dart:Dart"
    "lua:Lua"
    "pl:Perl"
    "pm:Perl"
    "r:R"
    "m:Objective-C"
    "mm:Objective-C"
    "ex:Elixir"
    "exs:Elixir"
    "erl:Erlang"
    "hrl:Erlang"
    "hs:Haskell"
    "lhs:Haskell"
    "clj:Clojure"
    "cljs:Clojure"
    "cljc:Clojure"
    "scm:Scheme"
    "rkt:Racket"
    "d:D"
    "nim:Nim"
    "v:V"
    "zig:Zig"
    "fs:F#"
    "ml:OCaml"
    "mli:OCaml"
    "coffee:CoffeeScript"
    "vue:Vue"
    "svelte:Svelte"
    "astro:Astro"
    "solid:SolidJS"
    "qml:QML"
    "purs:PureScript"
    "res:ReScript"
    "toml:TOML"
    "ini:INI"
    "cfg:Config"
    "conf:Config"
    "makefile:Makefile"
    "dockerfile:Dockerfile"
    "sln:Solution"
    "csproj:C# Project"
    "vb:Visual Basic"
    "vbs:VBScript"
    "ps1:PowerShell"
    "psm1:PowerShell"
    "psd1:PowerShell"
    "bat:Batch"
    "cmd:Batch"
    "asm:Assembly"
    "s:Assembly"
    "xaml:XAML"
    "axaml:XAML"
    "gradle:Gradle"
    "groovy:Groovy"
    "gvy:Groovy"
    "gy:Groovy"
    "gsp:Groovy"
)

# Fast scanning using find with direct processing
echo -e "${CYAN}Scanning $TARGET_DIR...${RESET}"

# Use temporary files for ultra-fast counting (compatible with all bash versions)
TEMP_COUNTS=$(mktemp)
TEMP_LINES=$(mktemp)
TEMP_FILES=$(mktemp)
TEMP_TOTAL_LINES=$(mktemp)
trap "rm -f $TEMP_COUNTS $TEMP_LINES $TEMP_FILES $TEMP_TOTAL_LINES" EXIT

# Function to get language for extension (ultra-optimized)
get_language() {
    local extension="$1"
    for mapping in "${LANGUAGE_MAPPING[@]}"; do
        local ext="${mapping%%:*}"
        local lang="${mapping#*:}"
        if [[ "$extension" == "$ext" ]]; then
            echo "$lang"
            return
        fi
    done
    echo "Other"
}

# Determine file listing method
# We need to list files relative to TARGET_DIR, or handle paths correctly
# Best approach: subshell in TARGET_DIR
list_files() {
    cd "$TARGET_DIR" || return
    
    # Check if git is available and we are in a git repo
    if command -v git >/dev/null 2>&1 && git rev-parse --is-inside-work-tree >/dev/null 2>&1; then
        # Use git ls-files to respect .gitignore
        # --cached: tracked files
        # --others: untracked files
        # --exclude-standard: respect .gitignore for untracked files
        git ls-files --cached --others --exclude-standard -z
    else
        # Fallback to find
        find . -type f \
            -not -path '*/\.git/*'
            -not -path '*/node_modules/*'
            -not -path '*/target/*'
            -not -path '*/build/*'
            -not -name '.*' \
            -print0 2>/dev/null
    fi
}

# Process files with maximum speed using process substitution
# We run list_files in a subshell, so we need to be careful with paths if TARGET_DIR was absolute
# but we cd inside list_files, so paths outputted are relative to TARGET_DIR.
# We need to make sure we can read them. 
# If we run the loop in the current shell (outside list_files), we are still in original dir.
# So we need to prepend TARGET_DIR to the filename for 'wc'.

while IFS= read -r -d '' rel_file; do
    # Construct full path for reading
    if [[ "$TARGET_DIR" == "." ]]; then
        file="$rel_file"
    else
        # Remove leading ./ if present to avoid double //
        clean_rel="${rel_file#./}"
        file="$TARGET_DIR/$clean_rel"
    fi
    
    # Get file extension and language
    filename="$(basename "$file")"
    extension="${filename##*.}"
    language=$(get_language "$extension")
    
    # Count lines with maximum efficiency
    # Use fallback if file read fails (e.g. permission or strange char)
    if [[ -f "$file" ]]; then
        lines=$(wc -l "$file" 2>/dev/null | awk '{print $1}')
        lines=${lines:-0}
        
        # Store data in temporary files
        echo "$file" >> "$TEMP_FILES"
        echo "$lines" >> "$TEMP_TOTAL_LINES"
        
        # Fast counting using temporary files
        if grep -q "^$language:" "$TEMP_COUNTS" 2>/dev/null; then
            current_count=$(grep "^$language:" "$TEMP_COUNTS" | cut -d: -f2)
            new_count=$((current_count + 1))
            current_lines=$(grep "^$language:" "$TEMP_LINES" | cut -d: -f2)
            new_lines=$((current_lines + lines))
            
            # Fast in-place update
            if [[ "$OSTYPE" == "darwin"* ]]; then
                sed -i "" "s/^$language:$current_count/$language:$new_count/" "$TEMP_COUNTS" 2>/dev/null || true
                sed -i "" "s/^$language:$current_lines/$language:$new_lines/" "$TEMP_LINES" 2>/dev/null || true
            else
                sed -i "s/^$language:$current_count/$language:$new_count/" "$TEMP_COUNTS" 2>/dev/null || true
                sed -i "s/^$language:$current_lines/$language:$new_lines/" "$TEMP_LINES" 2>/dev/null || true
            fi
        else
            echo "$language:1" >> "$TEMP_COUNTS"
            echo "$language:$lines" >> "$TEMP_LINES"
        fi
    fi
    
done < <(list_files)

# Calculate totals from temporary files
total_files=$(wc -l "$TEMP_FILES" 2>/dev/null | awk '{print $1}')
total_lines=$(awk '{sum+=$1} END {print sum}' "$TEMP_TOTAL_LINES" 2>/dev/null || echo "0")

# Display results with minimal overhead
echo ""
echo -e "${BOLD}${BLUE}Results:${RESET}"
echo -e "${BLUE}--------${RESET}"

if [[ $total_files -eq 0 ]]; then
    echo "No files found."
    exit 0
fi

# Show top languages by lines of code
echo -e "${BOLD}By lines of code:${RESET}"
sort -t: -k2 -nr "$TEMP_LINES" | head -"$TOP_LANGUAGES" | while read line; do
    language="${line%%:*}"
    lines="${line#*:}"
    percentage=$(awk "BEGIN {printf \"%.2f\", ($lines * 100) / $total_lines}")
    
    # Color coding for percentage
    p_color="$RESET"
    if (( $(echo "$percentage > 20" | bc -l 2>/dev/null || echo 0) )); then p_color="$GREEN"; fi
    if (( $(echo "$percentage > 50" | bc -l 2>/dev/null || echo 0) )); then p_color="$YELLOW"; fi
    
    printf "  ${CYAN}%-15s${RESET} %5d lines (${p_color}%s%%${RESET})\n" "$language" "$lines" "$percentage"
done

echo ""
echo -e "${BOLD}By file count:${RESET}"
sort -t: -k2 -nr "$TEMP_COUNTS" | head -"$TOP_LANGUAGES" | while read line; do
    language="${line%%:*}"
    count="${line#*:}"
    percentage=$(awk "BEGIN {printf \"%.2f\", ($count * 100) / $total_files}")
    printf "  ${CYAN}%-15s${RESET} %5d files (${GREEN}%s%%${RESET})\n" "$language" "$count" "$percentage"
done

echo ""
echo -e "Total: ${BOLD}$total_files${RESET} files, ${BOLD}$total_lines${RESET} lines"
